FROM dunglas/frankenphp:1.4-php8.4-alpine

# 1. Installer les extensions PHP requises (Ajout de GD)
RUN install-php-extensions \
    pcntl \
    pdo_mysql \
    redis \
    intl \
    zip \
    opcache \
    gd \
    @composer

# 2. Configurer les variables d'environnement de production
ENV NODE_MAJOR=20
ENV SERVER_NAME=":80"
ENV APP_ENV=production
ENV APP_DEBUG=false

# 3. Installer Node.js et NPM
RUN apk add --no-cache nodejs npm

# 4. Définir le répertoire de travail
WORKDIR /app

# 5. Copier les fichiers du projet
COPY . /app

# 6. Installer les dépendances PHP et Node
RUN composer install --no-dev --optimize-autoloader --no-interaction
RUN npm install && npm run build

# 7. Optimiser la configuration Laravel
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# 8. Donner les bonnes permissions aux dossiers de stockage
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache

# Copier et configurer le script d'entrée
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]

# 9. Démarrer directement via le binaire FrankenPHP (évite le bug de PID d'Octane sur Alpine)
CMD ["frankenphp", "run", "--config", "/app/vendor/laravel/octane/bin/Caddyfile"]

